# Runs main.py the way Fugleramme's own service runs: at boot, after the network,
# restarted five seconds after any exit. Logs: journalctl -u fugleramme-client -f
#
# The paths follow the user: for a user other than pi, change all three of User,
# WorkingDirectory and ExecStart. The Python is the virtualenv Pimoroni's inky
# installer makes in the user's home.

[Unit]
Description=Fugleramme client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/fugleramme-client
ExecStart=/home/pi/.virtualenvs/pimoroni/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
