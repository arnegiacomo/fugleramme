# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.venv-rembg/
venv/

# Artwork pipeline: scraping, background removal, curation into a style, and the
# scans and cut-outs they work on. All of it runs on the workstation only, never
# on the Pi, and nothing the frame runs depends on it - so it stays local.
scripts/
wikimedia-scrape/
rawpixel-scrape/

# Runtime artifacts: BirdNET-Go's DB (detector/data) and the frame's rendered output
data/
*.db
*.db-wal
*.db-shm
frame.png

# Per-Pi detector config, generated from config.yaml.template by setup.sh
detector/config/config.yaml

# Per-Pi container env (UID/GID/ALSA card), written by setup.sh
detector/.env

# Built docs site
site/
