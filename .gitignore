# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv*/
venv/

# Artwork tooling: auditing manifests, reviewing halos, normalising cut-outs and
# benchmarking the packer. Workstation only, never on the Pi, and nothing the
# frame runs depends on it - so it stays local.
scripts/

# Runtime artifacts: BirdNET-Go's DB (detector/data) and the frame's rendered output
data/
*.db
*.db-wal
*.db-shm
frame.png

# Per-Pi detector config, generated from config.yaml.template by setup.sh
detector/config/config.yaml

# Per-Pi container env (UID/GID/ALSA card), written by run.sh
detector/.env

# Per-Pi install choices (ports, where BirdNET-Go runs), written by install.sh
frame.env

# Built docs site
site/

# A built plate review: its scan, plate, flags and diff layers run about a megabyte
# a bird. The page under tools/platereview is checked in, what it renders is not.
tools/platereview/review*/

# Agent scratch: local harness settings and the worktrees it checks out. The skills
# under .claude/skills are checked in, so the folder is ignored a child at a time.
.claude/*
!.claude/skills/
