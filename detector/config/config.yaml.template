# Template for the per-Pi config. setup.sh copies this to config.yaml (gitignored).
# Only keys differing from BirdNET-Go's defaults are set; the capture device is
# picked in the BirdNET-Go UI (Settings -> Audio), not here.
# Reference: https://github.com/tphakala/birdnet-go/wiki

birdnet:
  locale: en-us
  threshold: 0.8
  latitude: 60.39
  longitude: 5.32
  overlap: 1.5               # deep detection "lenient": require 2 confirmations in 15s, drops one-off false positives
  rangefilter:
    threshold: 0.05          # up from the 0.01 default: cut species unlikely at this lat/lon + week

realtime:
  interval: 15               # min seconds between repeat detections of a species
  audio:
    export:
      enabled: false

output:
  sqlite:
    enabled: true
    path: /data/birdnet.db

# BirdNET-Go defaults every module to debug, which cost ~82MB/day. default_level
# alone will not do it - the per-module defaults outrank it, so each is named.
# Flip one back to debug to troubleshoot that module.
logging:
  default_level: info
  file_output:
    max_size: 10             # MB before rotation; modules inherit these caps
    max_age: 7
    max_rotated_files: 2
    compress: true
  modules:
    access: {level: info}
    analysis: {level: info}
    api: {level: info}
    audio: {level: info}
    auth: {level: info}
    backup: {level: info}
    birdnet: {level: info}
    birdweather: {level: info}
    config: {level: info}
    datastore: {level: info}
    diskmanager: {level: info}
    ebird: {level: info}
    events: {level: info}
    imageprovider: {level: info}
    monitor: {level: info}
    mqtt: {level: info}
    notifications: {level: info}
    securefs: {level: info}
    security: {level: info}
    spectrogram: {level: info}
    support: {level: info}
    telemetry: {level: info}
    weather: {level: info}
