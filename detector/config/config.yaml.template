# Template for the per-Pi config. setup.sh copies this to config.yaml (gitignored)
# and fills in the capture device. Only keys differing from BirdNET-Go's defaults
# are set. Reference: https://github.com/tphakala/birdnet-go/wiki

birdnet:
  locale: en-us
  threshold: 0.7
  latitude: 60.39
  longitude: 5.32
  rangefilter:
    model: latest
    threshold: 0.01

realtime:
  interval: 15               # min seconds between repeat detections of a species
  audio:
    sources:
      - name: "USB mic"
        device: "PICK_WITH_SETUP"   # set automatically by setup.sh from `arecord -l`
        gain: 0
    export:
      enabled: false

output:
  sqlite:
    enabled: true
    path: /data/birdnet.db
  mysql:
    enabled: false
